doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Falcon Heavy
        link(rel="stylesheet", href="style.css")
        link(rel="shortcut icon", href="./static/favicon.png", type="image/png")
        
    body
        .container
            .nav-space
            header.header 
                .header-inner 
                    a.logo(href="#") 
                        img(src='./static/logo.svg')
                    div.header-inner-main-text
                        a.trans-target(href='#') Falcon 9
                        a.trans-target(href='#') Falcon Heavy
                        a.trans-target(href='#') Dragon
                        a.trans-target(href='#') Updates
                    
                    div.header-inner-secondary-text
                        a.trans-target(href='#') About
                        a.trans-target(href='#') Gallery
                        a.trans-target(href='#') Shop

                    
                    .buttons
                        button.trans-target.btn.btn-ua UA
                        
                        button.trans-target.btn.btn-en EN

                    .mobile-menu
                        button.hamburger
                            img.burger-icon(src="./static/hamburger-menu-svgrepo-com.svg", alt="")

                    
            nav.hamburger-menu
                    ul
                        li 
                            a.trans-target(href='#') Falcon 9
                        li 
                            a.trans-target(href='#') Falcon Heavy
                        li 
                            a.trans-target(href='#') Dragon
                        li 
                            a.trans-target(href='#') Updates

                        li 
                            a.trans-target.secondary(href='#') About

                        li 
                            a.trans-target.secondary(href='#') Gallery

                        li 
                            a.trans-target.secondary(href='#') Shop

                        li
                            button.trans-target.btn.btn-ua-ham UA        
                            button.trans-target.btn.btn-en-ham EN
                        

            main.main
                h1.main-title.trans-target Falcon Heavy
                p.trans-target The most powerful operational rocket in the world by a factor of two
                div.vertical-line
                img.planet(src='./static/planet.png')
            section.falcon
                .info-falcon
                    h2.overview.trans-target FALCON HEAVY OVERVIEW
                    .columns 
                        .column1 
                            p.trans-target HEIGHT 
                            p.trans-target DIAMETER 
                            p.trans-target MASS
                            p.trans-target PAYLOAD TO LEO 
                            p.trans-target PAYLOAD TO GTO
                            p.trans-target PAYLOAD TO MARS 

                        .column2 

                            .column2-text
                                p.trans-target.phone-target 70 m /
                                span.secondary.trans-target  229.6 ft 
                            .column2-text
                            
                                p.trans-target.phone-target 12.2 m /
                                span.secondary.trans-target  39.9 ft  
                            .column2-text

                                p.trans-target.phone-target 1,420,788 kg /
                                span.secondary.trans-target  3,125,735 lb
                            .column2-text

                                p.trans-target.phone-target 63,800 kg /
                                span.secondary.trans-target  140,660 lb  
                            .column2-text

                                p.trans-target.phone-target 26,700 kg /
                                span.secondary.trans-target  58,860 lb
                            .column2-text

                                p.trans-target.phone-target 16,800 kg /
                                span.secondary.trans-target  37,040 lb


                    h2.perfomance.trans-target UNMATCHED PERFOMANCE
                    .perfomance-text
                        p.trans-target With more than 5 million pounds of thrust at liftoff, Falcon Heavy is the most capable rocket flying. By comparison, the liftoff thrust of the Falcon Heavy equals approximately eighteen 747 aircraft at full power. Falcon Heavy can lift the equivalent of a fully loaded 737 jetliner—complete with passengers, luggage and fuel—to orbit.
                img.falcon-img(src='./static/falcon.png')
            footer.footer
                a.logo(href="#") 
                    img.footer-logo(src="./static/logo.svg", alt="")

                .socials 
                    span 
                        a(href='#') Twitter
                    span 
                        a(href='#') Youtube
                    span 
                        a(href='#') Instagram
                    span 
                        a(href='#') Flickr
                    span 
                        a(href='#') LinkedIn
                    span 
                        a.trans-target(href='#') Privacy
                    span 
                        a.trans-target(href='#') Policy

                .email 
                    span.trans-target For additional questions, contact rideshare@spacex.com
                
                a.button.trans-target(href="#") Contact Us

    script(src="script.js")
